---
// GitHub Discussions comments via giscus — same repo/category mapping used
// on the MkDocs version of this site, so threads stay unified across both
// while the migration is in progress.
---

<div class="giscus-wrapper">
	<script
		is:inline
		src="https://giscus.app/client.js"
		data-repo="Sakthi-S99/guidewire-learning-journal"
		data-repo-id="R_kgDOTGPiug"
		data-category="General"
		data-category-id="IC_kwDOTGPius4DASPd"
		data-mapping="pathname"
		data-strict="0"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="bottom"
		data-theme="preferred_color_scheme"
		data-lang="en"
		crossorigin="anonymous"
		async></script>
</div>

<style>
	.giscus-wrapper {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
</style>
